# 1. Production Database (PostgreSQL - Neon, Supabase, AWS RDS, Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/bexo?sslmode=require"

# 2. NextAuth Configuration
NEXTAUTH_SECRET="your-32-char-random-secret-generated-via-openssl"
NEXTAUTH_URL="https://bexo.run"

# 3. Google OAuth Provider (Google Cloud Console)
# Redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. GitHub OAuth Provider (GitHub Developer Settings)
# Callback URL: https://your-domain.com/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 5. Stripe Payments & Webhooks (Stripe Dashboard)
# Webhook URL: https://your-domain.com/api/webhooks/payment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 6. Transactional Email Service (Resend / Postmark / SendGrid)
RESEND_API_KEY="re_..."
EMAIL_FROM_ADDRESS="notifications@bexo.run"

# 7. Distributed Rate Limiting (Upstash Redis - Optional for multi-region)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


